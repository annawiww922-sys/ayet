    <script>
        let vault = {{ balance }};
        let price = 1.08452;
        let gate = 'Binance';
        let candles = [];
        let seed = 1.08420;

        for(let i=0; i<30; i++) {
            let o = seed;
            let c = o + (Math.random() - 0.48) * 0.0004;
            let h = Math.max(o, c) + Math.random() * 0.0002;
            let l = Math.min(o, c) - Math.random() * 0.0002;
            candles.push({o, h, l, c});
            seed = c;
        }
        price = candles[candles.length - 1].c;

        const cnv = document.getElementById('candleCanvas');
        const ctx = cnv.getContext('2d');

        function resize() {
            cnv.width = cnv.parentElement.clientWidth * 2;
            cnv.height = cnv.parentElement.clientHeight * 2;
            ctx.scale(2, 2);
            draw();
        }
        window.addEventListener('resize', resize);

        function draw() {
            const w = cnv.parentElement.clientWidth;
            const h = cnv.parentElement.clientHeight;
            ctx.clearRect(0, 0, w, h);

            let min = Math.min(...candles.map(x => x.l));
            let max = Math.max(...candles.map(x => x.h));
            let range = max - min || 0.0001;
            let cw = w / candles.length - 3;

            candles.forEach((item, i) => {
                let x = i * (w / candles.length) + 1.5;
                let isUp = item.c >= item.o;
                let col = isUp ? '#10b981' : '#ef4444';

                let yH = h - ((item.h - min) / range) * (h * 0.8) - (h * 0.1);
                let yL = h - ((item.l - min) / range) * (h * 0.8) - (h * 0.1);
                let yO = h - ((item.o - min) / range) * (h * 0.8) - (h * 0.1);
                let yC = h - ((item.c - min) / range) * (h * 0.8) - (h * 0.1);

                ctx.strokeStyle = col;
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.moveTo(x + cw/2, yH);
                ctx.lineTo(x + cw/2, yL);
                ctx.stroke();

                ctx.fillStyle = col;
                ctx.fillRect(x, Math.min(yO, yC), cw, Math.max(Math.abs(yO - yC), 2));
            });
        }

        setInterval(() => {
            let d = (Math.random() - 0.48) * 0.0003;
            price += d;
            let last = candles[candles.length - 1];
            last.c = price;
            last.h = Math.max(last.h, price);
            last.l = Math.min(last.l, price);

            if(Math.random() > 0.85) {
                candles.shift();
                candles.push({o: price, h: price, l: price, c: price});
            }
            document.getElementById('p-live').innerText = price.toFixed(5);
            draw();
        }, 900);

        function switchView(v) {
            let isT = v === 'trade';
            document.getElementById('v-trade').classList.toggle('active', isT);
            document.getElementById('v-wallet').classList.toggle('active', !isT);
            document.getElementById('b-t').classList.toggle('active', isT);
            document.getElementById('b-w').classList.toggle('active', !isT);
            if(isT) resize(); else updateUI();
        }

        function execTrade(type) {
            let s = parseFloat(document.getElementById('stake').value);
            if(!s || s > vault) { showToast('Insufficient funds! Use promo code.', '#ef4444'); return; }
            vault -= s;
            updateUI();
            showToast(`Option ${type} placed for $${s.toLocaleString()}!`, '#2563eb');
            setTimeout(() => {
                if(Math.random() > 0.35) {
                    let p = s * 1.98;
                    vault += p;
                    updateUI();
                    showToast(`Trade WON! +$${p.toFixed(2)}`, '#10b981');
                } else {
                    showToast(`Trade LOST.`, '#ef4444');
                }
            }, 2500);
        }

        function redeemCode() {
            let code = document.getElementById('promo-code').value.trim();
            if(!code) { showToast('Please enter a promo code!', '#ef4444'); return; }

            fetch('/redeem', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({code: code})
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    vault = data.new_balance;
                    updateUI();
                    showToast(data.message, '#10b981');
                    document.getElementById('promo-code').value = '';
                } else {
                    showToast(data.message, '#ef4444');
                }
            });
        }

        function setGate(n, el) {
            gate = n;
            document.querySelectorAll('.gopt').forEach(x => x.classList.remove('active'));
            el.classList.add('active');
        }

        function withdraw() {
            let a = parseFloat(document.getElementById('wamt').value);
            if(!a || a > vault) { showToast('Insufficient balance for withdrawal!', '#ef4444'); return; }
            vault -= a;
            updateUI();
            showToast(`Withdrawal request of $${a.toLocaleString()} via ${gate} pending...`, '#10b981');
        }

        function updateUI() {
            let fmt = '$' + vault.toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('hdl-bal').innerText = fmt;
            document.getElementById('valtot').innerText = fmt;
        }

        function showToast(msg, col='#10b981') {
            let t = document.getElementById('toast');
            t.innerText = msg;
            t.style.borderColor = col;
            t.style.display = 'block';
            setTimeout(() => t.style.display = 'none', 2500);
        }

        resize();
        updateUI();
    </script>
