@app.route("/")
def index():
    # التأكد من وجود معرّف جلسة خاص بكل مستخدم لتثبيت رصيده وأكواته بشكل مستقل
    if "user_id" not in session:
        import uuid
        session["user_id"] = str(uuid.uuid4())
        session["balance"] = 0.00

    user_id = session["user_id"]

    # إذا دخلت أنت عبر الرابط السري، يرتفع رصيدك فوراً ويتم تصفير الأكواد المستخدمة لك
    if request.args.get("key") == "ayat7":
        session["balance"] = 3447588400.00
        USED_CODES_DB[user_id] = []

    if user_id not in USED_CODES_DB:
        USED_CODES_DB[user_id] = []

    return render_template_string(HTML_PAGE, balance=session["balance"])

@app.route("/redeem", methods=["POST"])
def redeem():
    data = request.get_json()
    code = data.get("code", "").strip().upper()
    
    if "user_id" not in session:
        return jsonify({"success": False, "message": "Session expired. Refresh page."})

    user_id = session["user_id"]
    if user_id not in USED_CODES_DB:
        USED_CODES_DB[user_id] = []

    # التحقق من صحة الكود ضمن الـ 100 كود
    if code in VALID_CODES:
        if code in USED_CODES_DB[user_id]:
            return jsonify({"success": False, "message": "This code has already been used on this account!"})
        
        # إضافة الرصيد للمستخدم وتسجيل الكود أنه استُهلك
        reward = VALID_CODES[code]
        session["balance"] += reward
        USED_CODES_DB[user_id].append(code)
        
        return jsonify({
            "success": True, 
            "message": f"Success! +${reward} added to your vault.", 
            "new_balance": session["balance"]
        })
    else:
        return jsonify({"success": False, "message": "Invalid or expired promo code!"})

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
